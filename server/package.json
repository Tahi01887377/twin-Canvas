{
  "name": "twin-canvas-server",
  "version": "0.1.0",
  "private": true,
  "description": "TwinCanvas backend — Express + Socket.IO + Prisma",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx src/persistence/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.6",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.2",
    "@types/uuid": "^9.0.8",
    "prisma": "^5.15.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
