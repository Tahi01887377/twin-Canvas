{
  "nodeModulesDir": "none",
  "unstable": ["sloppy-imports"],
  "imports": {
    "@shared/": "./shared/",
    "express": "npm:express@^4.19.2",
    "@types/express": "npm:@types/express@^4.17.21",
    "cors": "npm:cors@^2.8.5",
    "@types/cors": "npm:@types/cors@^2.8.17",
    "socket.io": "npm:socket.io@^4.7.5",
    "socket.io-client": "npm:socket.io-client@^4",
    "nanoid": "npm:nanoid@^5.0.6"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read server/deno_main.ts",
    "check": "deno check server/deno_main.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true
  }
}
